# Copiar como .env y completar. Nunca subir el .env al repositorio.
ANTHROPIC_API_KEY=

# Audios de WhatsApp → texto (Groq whisper-large-v3; respaldo OpenAI: https://api.openai.com/v1 + gpt-4o-transcribe)
TRANSCRIPCION_URL=https://api.groq.com/openai/v1
TRANSCRIPCION_MODELO=whisper-large-v3
TRANSCRIPCION_CLAVE=

