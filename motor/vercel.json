{
  "functions": {
    "api/whatsapp.ts": {
      "maxDuration": 60,
      "includeFiles": "{fichas,plantillas}/**"
    },
    "api/chat.ts": {
      "maxDuration": 60,
      "includeFiles": "{fichas,plantillas}/**"
    },
    "api/panel.ts": {
      "maxDuration": 30,
      "includeFiles": "{fichas,plantillas}/**"
    }
  },
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        }
      ]
    }
  ]
}
